# 服务端口
PORT=3000
HOST=127.0.0.1

# 1 = 使用 mock 模型（无需 API Key，生成 ffmpeg 测试片源跑通全链路）
MOCK=0

# 开发用默认 Key（正式使用请留空，由主播页输入）
# MINIMAX_API_KEY=

# 文本模型（剧本拆分/续写/弹幕分析）
TEXT_MODEL=MiniMax-M3

# 视频模型与档位
VIDEO_MODEL=MiniMax-H3-Max
VIDEO_RESOLUTION=480P

# 生成调度
GEN_CONCURRENCY=2
CLIP_DURATION=5
TARGET_BUFFER_SEC=30
MIN_BUFFER_SEC=15
POLL_INTERVAL_MS=3000

# SRS 推流 / 拉流地址
SRS_RTMP_URL=rtmp://127.0.0.1:1935/live
HLS_BASE=http://127.0.0.1:8080/live

# ffmpeg 可执行文件路径
FFMPEG=ffmpeg
FFPROBE=ffprobe

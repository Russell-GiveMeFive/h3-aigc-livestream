{
  "name": "h3-live-stream",
  "private": true,
  "version": "0.1.0",
  "description": "实时 AIGC 直播：剧本 → 分镜 → MiniMax H3-Max 极速生视频 → 首帧续接 → RTMP/HLS 播放",
  "type": "module",
  "scripts": {
    "predev": "node scripts/clear-dev-ports.cjs",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/src/index.ts",
    "selftest": "tsx scripts/selftest.ts",
    "test:douyin": "tsx scripts/test-douyin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dycast:sign-server": "tsx scripts/dycast-sign-server.ts",
    "clear:ports": "node scripts/clear-dev-ports.cjs",
    "srs": "docker compose up -d srs",
    "srs:down": "docker compose down"
  },
  "dependencies": {
    "express": "^4.21.2",
    "hls.js": "^1.5.20",
    "protobufjs": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "ws": "^8.18.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^9.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
